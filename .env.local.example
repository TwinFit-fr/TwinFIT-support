# Copy to `.env` (gitignored) or `.env.local` — Next.js loads both.
# Nhost Cloud (same project as TwinFit app / TwinFIT-backend .secrets.remote)
NEXT_PUBLIC_NHOST_SUBDOMAIN=
NEXT_PUBLIC_NHOST_REGION=

# OpenAI Images API (server-only — never expose as NEXT_PUBLIC_*)
OPENAI_API_KEY=

# Coach knowledge embeddings (server-only). Same keys as TwinFIT-backend .secrets.
# MISTRAL_API_KEY=
# ASSISTANT_LLM_API_KEY=
# ASSISTANT_LLM_BASE_URL=https://api.mistral.ai/v1
# ASSISTANT_EMBED_MODEL=mistral-embed

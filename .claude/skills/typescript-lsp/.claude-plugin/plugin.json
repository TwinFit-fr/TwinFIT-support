{
  "name": "twinfit-typescript-lsp",
  "description": "TypeScript language server for Claude Code in TwinFIT-support, run from the repo's node_modules (no global install)",
  "lspServers": {
    "typescript": {
      "command": "node",
      "args": ["${CLAUDE_PROJECT_DIR}/node_modules/typescript-language-server/lib/cli.mjs", "--stdio"],
      "extensionToLanguage": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".mts": "typescript",
        ".cts": "typescript",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".mjs": "javascript",
        ".cjs": "javascript"
      }
    }
  }
}
